# Title:    Check with all genres
# Question: Does the answer change if we use all the genres of each artist instead of one primary genre?
# Output:   status, number of routes, number of artist pairs behind them

PREFIX riff: <https://w3id.org/riff/ontology#>
PREFIX genre: <https://w3id.org/riff/genre/>
PREFIX artist: <https://w3id.org/riff/artist/>
PREFIX mm: <https://w3id.org/polifonia/ontology/music-meta/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?status (COUNT(*) AS ?routes) (SUM(?weight) AS ?artistPairs)
WHERE {
  {
    SELECT ?from ?to (COUNT(*) AS ?weight)
    WHERE {
      ?follower mm:isInfluencedBy ?artist .
      ?artist mm:hasGenre ?from .
      ?follower mm:hasGenre ?to .
      FILTER(?from != ?to)
    }
    GROUP BY ?from ?to
  }
  BIND(IF(EXISTS { ?to riff:hasStylisticOrigin ?from }, "direct",
       IF(EXISTS { ?to riff:hasStylisticOrigin/riff:hasStylisticOrigin ?from }, "two-step",
       IF(EXISTS { ?from riff:hasStylisticOrigin|(riff:hasStylisticOrigin/riff:hasStylisticOrigin) ?to }, "reversed",
       "hidden"))) AS ?status)
}
GROUP BY ?status
ORDER BY DESC(?artistPairs)
