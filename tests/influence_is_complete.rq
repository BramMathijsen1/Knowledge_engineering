# Test: every influence has an influencer, an influenced artist, an evidence kind and a source.

PREFIX riff: <https://w3id.org/riff/ontology#>
PREFIX genre: <https://w3id.org/riff/genre/>
PREFIX artist: <https://w3id.org/riff/artist/>
PREFIX mm: <https://w3id.org/polifonia/ontology/music-meta/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?influence
WHERE {
  ?influence a riff:Influence .
  FILTER(!EXISTS { ?influence riff:influencer ?a }
      || !EXISTS { ?influence riff:influenced ?b }
      || !EXISTS { ?influence riff:hasEvidenceKind ?c }
      || !EXISTS { ?influence <http://www.w3.org/ns/prov#wasDerivedFrom> ?d })
}
