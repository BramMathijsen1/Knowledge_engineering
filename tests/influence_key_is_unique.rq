# Test: two statements can't have the same artists, evidence kind and source (the key of riff:Influence).

PREFIX riff: <https://w3id.org/riff/ontology#>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?influenced ?influencer ?kind ?source (COUNT(?influence) AS ?statements)
WHERE {
  ?influence a riff:Influence ;
             riff:influenced ?influenced ;
             riff:influencer ?influencer ;
             riff:hasEvidenceKind ?kind ;
             prov:wasDerivedFrom ?source .
}
GROUP BY ?influenced ?influencer ?kind ?source
HAVING (COUNT(?influence) > 1)
