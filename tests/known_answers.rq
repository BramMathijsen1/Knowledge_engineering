# Test: influences we know about must be in the graph. The rows returned are the missing ones.

PREFIX riff: <https://w3id.org/riff/ontology#>
PREFIX genre: <https://w3id.org/riff/genre/>
PREFIX artist: <https://w3id.org/riff/artist/>
PREFIX mm: <https://w3id.org/polifonia/ontology/music-meta/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?artist ?influence
WHERE {
  VALUES (?artist ?influence) {
    (artist:nirvana artist:led_zeppelin)
    (artist:led_zeppelin artist:robert_johnson)
    (artist:kendrick_lamar artist:tupac_shakur)
    (artist:beyonce artist:mariah_carey)
    (artist:radiohead artist:r_e_m)
    (artist:miles_davis artist:ahmad_jamal)
  }
  FILTER NOT EXISTS { ?artist mm:isInfluencedBy ?influence }
}
