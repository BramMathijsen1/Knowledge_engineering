# Test: a genre can't appear before the genre it comes from.

PREFIX riff: <https://w3id.org/riff/ontology#>
PREFIX genre: <https://w3id.org/riff/genre/>
PREFIX artist: <https://w3id.org/riff/artist/>
PREFIX mm: <https://w3id.org/polifonia/ontology/music-meta/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?child ?childYear ?parent ?parentYear
WHERE {
  ?child riff:hasStylisticOrigin ?parent ;
         riff:emergedIn ?childYear .
  ?parent riff:emergedIn ?parentYear .
  FILTER(?childYear < ?parentYear)
}
