# Test: an influencer normally starts before the influenced artist stops, and not 20 years
# after that artist starts. Real exceptions must explain themselves with riff:dateNote.

PREFIX riff: <https://w3id.org/riff/ontology#>
PREFIX genre: <https://w3id.org/riff/genre/>
PREFIX artist: <https://w3id.org/riff/artist/>
PREFIX mm: <https://w3id.org/polifonia/ontology/music-meta/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?influence ?influencerStart ?influencedStart ?influencedEnd
WHERE {
  ?influence riff:influencer ?influencer ;
             riff:influenced ?influenced .
  ?influencer riff:activeFrom ?influencerStart .
  ?influenced riff:activeFrom ?influencedStart .
  OPTIONAL { ?influenced riff:activeTo ?influencedEnd }
  FILTER(?influencerStart - ?influencedStart >= 20 || (BOUND(?influencedEnd) && ?influencerStart > ?influencedEnd))
  FILTER NOT EXISTS { ?influence riff:dateNote ?note }
}
